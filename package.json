{
  "name": "harvest21-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "env-cmd -f .env.develop next dev",
    "dev:local": "env-cmd -f .env.local next dev",
    "dev:prod": "env-cmd -f .env.prod next dev",
    "dev:staging": "env-cmd -f .env.staging next dev",
    "build": "next build",
    "build:prod": "env-cmd -f .env.prod next build",
    "build:staging": "env-cmd -f .env.staging next build",
    "build:develop": "env-cmd -f .env.develop next build",
    "start": "next start",
    "start:prod": "env-cmd -f .env.prod next start",
    "start:staging": "env-cmd -f .env.staging next start",
    "dev:cypress": "env-cmd -f .env.cypress-local next dev",
    "test:e2e:local": "cypress run --config baseUrl=http://localhost:3000 --spec 'cypress/e2e/missionary-e2e/**' --env CYPRESS_ENV=local",
    "test:e2e:local:open": "cypress open --config baseUrl=http://localhost:3000 --env CYPRESS_ENV=local",
    "docker:build": "bash scripts/docker-build.sh",
    "test:e2e:docker": "cypress run --config baseUrl=http://localhost:3001 --spec 'cypress/e2e/missionary-e2e/**' --env CYPRESS_SUPABASE_URL=http://localhost:54321,CYPRESS_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU,CYPRESS_MAILPIT_URL=http://localhost:54324",
    "test:e2e:docker:open": "cypress open --config baseUrl=http://localhost:3001 --env CYPRESS_SUPABASE_URL=http://localhost:54321,CYPRESS_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU,CYPRESS_MAILPIT_URL=http://localhost:54324",
    "lint": "eslint",
    "test:unit": "vitest run",
    "type-check": "tsc --noEmit",
    "postinstall": "node -e \"try{const fs=require('fs');fs.copyFileSync('node_modules/pdfjs-dist/build/pdf.worker.min.mjs','public/pdf.worker.min.mjs');}catch(e){}\""
  },
